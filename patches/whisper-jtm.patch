+int whisper_uses_coreml(struct whisper_context * ctx) {
+#ifdef WHISPER_USE_COREML
+    return ctx && ctx->state && ctx->state->ctx_coreml != nullptr;
+#else
+    (void) ctx;
+    return 0;
+#endif
+}
+
+void whisper_set_audio_ctx(struct whisper_context * ctx, int n_audio_ctx) {
+    if (ctx && ctx->state) {
+        ctx->state->exp_n_audio_ctx = (n_audio_ctx > 0 && n_audio_ctx <= ctx->model.hparams.n_audio_ctx) ? n_audio_ctx : 0;
+    }
+}
